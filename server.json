{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.bitculator/market-data",
  "title": "Bitculator",
  "description": "Crypto market data for AI agents: live prices, OHLCV, sentiment, indicators and exchanges.",
  "version": "1.0.1",
  "websiteUrl": "https://bitculator.com/en/crypto-mcp",
  "repository": {
    "url": "https://github.com/Bitculator/bitculator-mcp",
    "source": "github",
    "id": "1404503821"
  },
  "icons": [
    {
      "src": "https://bitculator.com/media/favicon/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://bitculator.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your Bitculator MCP key>, created in the MCP console at https://bitculator.com/user/developer/mcp",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
